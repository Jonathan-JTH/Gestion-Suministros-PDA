APP_NAME="Gestión de Suministros"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_suministros
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=
JWT_TTL=60
JWT_ISSUER="${APP_URL}"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Envío SMTP vs buzón TI (recepción) ---
# MAIL_* = cuenta que ENVÍA (ej. estudiante @miumg.edu.gt → smtp.gmail.com + contraseña de aplicación Google).
# NOTIFICACION_SOPORTE_EMAIL = siempre el buzón Informática Fabrigas (avisos TI).
# Sin SMTP: MAIL_MAILER=log

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_cuenta@miumg.edu.gt
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=tu_cuenta@miumg.edu.gt
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICACION_SOPORTE_EMAIL=soporteti@grupofabrigas.com
# Valores por defecto si aún no hay registro en BD (Configuración → admin):
NOTIFICACIONES_EMAIL_HABILITADAS=true
NOTIFICACION_DESPACHO_DESTINATARIO_HABILITADO=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
